# Copy to .env.local and fill in from Supabase → Project settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Clerk auth — publishable key (CI hard-fails the build if this is unset).
# Get from Clerk dashboard → API keys (production instance clerk.atlaasgo.com).
VITE_CLERK_PUBLISHABLE_KEY=

# Stripe — publishable key (pk_…) for the web checkout PaymentElement.
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional: site origin used for password-reset / magic-link redirects.
# Leave blank to use window.location.origin at runtime.
VITE_SITE_URL=
