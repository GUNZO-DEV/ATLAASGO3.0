{
  "name": "AtlaasGo · 03 · Review request 24h after delivery",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [200, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{$json.payload.new_status}}",
              "rightValue": "delivered",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "is-delivered",
      "name": "Is delivered?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 400]
    },
    {
      "parameters": {
        "amount": 24,
        "unit": "hours"
      },
      "id": "wait-24h",
      "name": "Wait 24 hours",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [680, 320],
      "webhookId": "wait-review-request"
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "reviews",
        "returnAll": false,
        "limit": 1,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            { "keyName": "order_id", "condition": "eq", "keyValue": "={{$node[\"Execute Workflow Trigger\"].json.payload.order_id}}" }
          ]
        }
      },
      "id": "check-review",
      "name": "Supabase · existing review?",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [920, 320],
      "credentials": {
        "supabaseApi": { "id": "atlaasgo-supabase", "name": "AtlaasGo Supabase (service role)" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{$json.id}}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "empty" }
            }
          ]
        }
      },
      "id": "no-review-yet",
      "name": "No review yet?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1160, 320]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "profiles",
        "returnAll": false,
        "limit": 1,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            { "keyName": "id", "condition": "eq", "keyValue": "={{$node[\"Execute Workflow Trigger\"].json.payload.customer_id}}" }
          ]
        }
      },
      "id": "lookup-customer",
      "name": "Supabase · customer profile",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1400, 220],
      "credentials": {
        "supabaseApi": { "id": "atlaasgo-supabase", "name": "AtlaasGo Supabase (service role)" }
      }
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "tableId": "notifications",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "user_id", "fieldValue": "={{$node[\"Execute Workflow Trigger\"].json.payload.customer_id}}" },
            { "fieldId": "kind",    "fieldValue": "review_request" },
            { "fieldId": "title",   "fieldValue": "How was your meal?" },
            { "fieldId": "body",    "fieldValue": "=Leave a quick review for your last order — it takes 10 seconds." },
            { "fieldId": "payload", "fieldValue": "={{ { order_id: $node[\"Execute Workflow Trigger\"].json.payload.order_id } }}" }
          ]
        }
      },
      "id": "in-app-notif",
      "name": "Supabase · in-app nudge",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1640, 220],
      "credentials": {
        "supabaseApi": { "id": "atlaasgo-supabase", "name": "AtlaasGo Supabase (service role)" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{$node[\"Supabase · customer profile\"].json.phone}}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ]
        }
      },
      "id": "has-phone",
      "name": "Customer has phone?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1640, 380]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "phoneNumberId": "={{$credentials.phoneNumberId}}",
        "recipientPhoneNumber": "={{$node[\"Supabase · customer profile\"].json.phone}}",
        "messageType": "text",
        "textBody": "=⭐ How was your AtlaasGo order?\\n\\nLeave a quick review — 10 seconds, helps the next person pick a great spot:\\nhttps://atlaasgo.com/track/{{$node[\"Execute Workflow Trigger\"].json.payload.order_id}}\\n\\nBsahha! 🥘"
      },
      "id": "whatsapp-review",
      "name": "WhatsApp · review nudge",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [1880, 380],
      "credentials": {
        "whatsAppApi": { "id": "whatsapp-cloud", "name": "AtlaasGo WhatsApp Business" }
      }
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [[{ "node": "Is delivered?", "type": "main", "index": 0 }]]
    },
    "Is delivered?": {
      "main": [[{ "node": "Wait 24 hours", "type": "main", "index": 0 }], []]
    },
    "Wait 24 hours": {
      "main": [[{ "node": "Supabase · existing review?", "type": "main", "index": 0 }]]
    },
    "Supabase · existing review?": {
      "main": [[{ "node": "No review yet?", "type": "main", "index": 0 }]]
    },
    "No review yet?": {
      "main": [
        [
          { "node": "Supabase · customer profile", "type": "main", "index": 0 },
          { "node": "Customer has phone?", "type": "main", "index": 0 }
        ],
        []
      ]
    },
    "Supabase · customer profile": {
      "main": [[{ "node": "Supabase · in-app nudge", "type": "main", "index": 0 }]]
    },
    "Customer has phone?": {
      "main": [[{ "node": "WhatsApp · review nudge", "type": "main", "index": 0 }], []]
    }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "atlaasgo" }, { "name": "review" }]
}
