{
  "expo": {
    "name": "AtlaasGo",
    "slug": "atlaasgo",
    "scheme": "atlaasgo",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF7F2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.atlaasgo.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AtlaasGo needs your location to deliver to your exact spot in Ifrane.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.atlaasgo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF5722"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AtlaasGo uses your location to coordinate delivery to your doorstep."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF5722"
        }
      ],
      "@bacons/apple-targets"
    ],
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.atlaasgo.app.widget",
                  "targetName": "AtlaasGoWidget"
                }
              ]
            }
          }
        },
        "projectId": "cd78dbac-5b5d-4e8e-a51a-1d86f93f5ff2"
      }
    },
    "owner": "atlaasgo"
  }
}
