# ─────────────────────────────────────────────────────────────────────────────
# Local dev backend (recommended) — uses the Firestore emulator from ../backend
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_USE_EMULATOR=true
# Optional override; leave blank to auto-detect (10.0.2.2 on Android, LAN IP on
# physical devices, 127.0.0.1 on iOS simulator).
EXPO_PUBLIC_EMULATOR_HOST=

# ─────────────────────────────────────────────────────────────────────────────
# Production Firebase (only used when EXPO_PUBLIC_USE_EMULATOR=false)
# Copy from Firebase Console → Project settings → Your apps → Web app
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
