# ─────────────────────────────────────────────────────────────────────────────
# AtlaasGo Mobile — Supabase backend (same project as the web app)
# Copy this file to `.env` and fill in the values below.
#   cp .env.example .env
#
# Both values are PUBLISHABLE (safe to ship in the app bundle). Row access is
# enforced by Postgres RLS, not by hiding these. Find them in:
#   Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Clerk (same instance as the web app — clerk.atlaasgo.com).
# Publishable key, safe to ship. Clerk Dashboard → API Keys.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Stripe publishable key (safe to ship). Stripe Dashboard → Developers → API keys.
# Used by the native PaymentSheet (wallet top-up + card checkout).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Android-only release keys (optional; features degrade gracefully) ────────
# Google Maps SDK for Android — powers the live rider-tracking map.
# Google Cloud Console → enable "Maps SDK for Android" → Credentials → API key.
# When empty, the order screen shows a static fallback instead of the map.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=

# Path to google-services.json for Android FCM / remote push (e.g. ./google-services.json).
# Firebase Console → add Android app (package com.atlaasgo.app) → download the file.
# Leave unset to build without remote push wired.
GOOGLE_SERVICES_JSON=
